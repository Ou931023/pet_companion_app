# =============================================================================
# backend/stt_proxy 環境變數範本（CR-0034 B5）
# -----------------------------------------------------------------------------
# 使用方式：複製本檔為 `.env`（同目錄），填入實際值；`.env` 絕不進版控。
# 本範本只列「變數名稱與用途」，所有值一律留空或佔位，請勿填入任何真實
# secret / token / API key。值的真正解析以 config/env.js 為準。
#
# 三環境語義（config/env.js normalizeAppEnv）：
#   - 顯式 APP_ENV 優先（development | staging | production）。
#   - 否則 NODE_ENV=production → production，其餘 → development。
#   - NODE_ENV=test 永不解析為 production（保護既有測試基線）。
#
# production 啟動會 fail-fast（config/env.js assertProductionEnvOrExit）：
#   缺必要變數或設定不安全旗標 → 印「只含變數名稱」的訊息後 process.exit(1)。
#   詳見 docs/PRODUCTION_CONFIG_CHECKLIST.md 與 PROJECT_ARCHITECTURE.md §7.1.1。
# =============================================================================


# -----------------------------------------------------------------------------
# Environment（環境語義）
# -----------------------------------------------------------------------------
# APP_ENV: development | staging | production。未設定時由 NODE_ENV 推導。
APP_ENV=development
# NODE_ENV: node 慣例環境（test / production 等）。NODE_ENV=test 不會被視為 production。
NODE_ENV=development


# -----------------------------------------------------------------------------
# Server（伺服器）
# -----------------------------------------------------------------------------
# PORT: HTTP 服務埠（預設 3001）。
PORT=3001
# HOST: 綁定的網路介面。
# - 純本機 / 模擬器開發：可用 127.0.0.1
# - iPhone 實機 Demo：請設為 0.0.0.0，讓同一 Wi-Fi 下的 iPhone 連得到後端。
HOST=0.0.0.0
# CORS 白名單來源（瀏覽器端 caregiver_web 用），逗號分隔。
# 新命名 CORS_ALLOWED_ORIGINS 優先；舊命名 ALLOWED_ORIGINS 為相容別名。
# production 必填（為空會 fail-fast）。
# 例：CORS_ALLOWED_ORIGINS=https://admin.your-domain.com,https://www.your-domain.com
CORS_ALLOWED_ORIGINS=
# 相容別名（未設定 CORS_ALLOWED_ORIGINS 時才讀此值）。
ALLOWED_ORIGINS=
# Rate limit（依 express-rate-limit）。
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_CALLS=60
REALTIME_RATE_LIMIT_WINDOW_MS=60000
REALTIME_RATE_LIMIT_MAX=6


# -----------------------------------------------------------------------------
# Database（PostgreSQL + pgvector）
# -----------------------------------------------------------------------------
# DATABASE_URL: PostgreSQL 連線字串。production 必填（缺則 fail-fast）。
# 例：DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
# PGVECTOR_ENABLED: 設為 true 才真正連 PG（含 pgvector 與 Admin Users API）。
# 未開啟時其他功能在 dev/staging 走 JSON fallback；
# GET /api/admin/users 一律需 PG（不做 JSON fallback）。
PGVECTOR_ENABLED=false
# 連線池（可選）。
# PG_POOL_MAX=
# PG_CONNECTION_TIMEOUT_MS=
# PG_IDLE_TIMEOUT_MS=


# -----------------------------------------------------------------------------
# OpenAI / Realtime / Memory / Search（AI 服務）
# -----------------------------------------------------------------------------
# OPENAI_API_KEY: OpenAI API key。production 必填（缺則 fail-fast）。絕不寫死於程式。
OPENAI_API_KEY=
# Realtime 語音模型與聲音。
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=alloy
# 長期記憶與 embedding。
EMBEDDING_MODEL=text-embedding-3-small
MEMORY_TOP_K=5
# MEMORY_MODEL=
# MEMORY_EXTRACT_MODEL=
# 對話標題 / 摘要模型（可選）。
# CONVERSATION_TITLE_MODEL=
# 日常照護任務 AI 影像確認的視覺模型（預設 gpt-4o-mini）。
# 缺 OPENAI_API_KEY 時拍照打卡不會壞，一律進 needs_review（不自動完成）。
# DAILY_CARE_VISION_MODEL=gpt-4o-mini
# Web / 可信來源搜尋。
TAVILY_API_KEY=
# WEB_SEARCH_SUMMARY_MODEL=
# SEARCH_SUMMARY_MODEL=
# SEARCH_STORAGE=
# DEFAULT_WEATHER_LOCATION=
# 台語 ASR（可選；未啟用時不影響國語語音）。
# TAIGI_ASR_ENABLED=
# TAIGI_ASR_PROVIDER=
# TAIGI_ASR_MODEL=
# TAIGI_ASR_MAX_UPLOAD_BYTES=


# -----------------------------------------------------------------------------
# Auth / Session（Firebase ID Token 驗證）
# -----------------------------------------------------------------------------
# production 必須設定 Firebase 服務帳戶（擇一），缺則 fail-fast：
#   方式 A：GOOGLE_APPLICATION_CREDENTIALS = service account JSON 檔路徑。
#   方式 B：拆欄位 FIREBASE_PROJECT_ID + FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY。
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# AUTH_ALLOW_MOCK: 未設定 Firebase 時是否允許 mock session（採信傳入識別）。
# 預設 true（dev/test）。production 一律被收斂為 false（強制驗 idToken，見 REQUIRE_AUTH）。
# CR-0045：此旗標同時守門 /api/care-alerts/notify 的 resident-caller 驗證——production（false）
#   強制真 idToken + 真 users row + 非 null users.elder_id；dev/test（true）才允許 mock caller
#   與「查無 row 時由 uid 推導 scoping elderId」的 dev-only seam。無新增 secret。
AUTH_ALLOW_MOCK=true
# 綁定截止天數（預設 60）。
BINDING_DEADLINE_DAYS=60


# -----------------------------------------------------------------------------
# Telegram Notification（Care Alert → Telegram 長照通知）
# -----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN: 向 @BotFather 申請的 Bot token。絕不寫死、絕不進版控。
# TELEGRAM_CARE_CHAT_ID: 接收通知的長照人員 / 家屬 chat id。
# 任一為空時通知回 telegram_not_configured，不影響語音與本機 CareAlert。
# 條件必檢：production 若設定了 TELEGRAM_CARE_CHAT_ID（視為啟用通知）卻缺
# TELEGRAM_BOT_TOKEN → fail-fast。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CARE_CHAT_ID=
# Care Alert → Telegram 冷卻（避免洗版，可選）。
# CARE_ALERT_TELEGRAM_COOLDOWN_ENABLED=
# CARE_ALERT_TELEGRAM_COOLDOWN_MS=


# -----------------------------------------------------------------------------
# Admin / Caregiver Web（身分與授權，見 docs/AUTHORIZATION_MODEL.md）
# -----------------------------------------------------------------------------
# 兩種身分可呼叫 caregiver-or-admin 路由（/api/care-alerts、/api/admin/elders*、
# /api/admin/daily-care-tasks）；解析由 services/admin/adminAuthContext.js 處理：
#
#   1) super_admin（最高權限，可見全部住民）
#      - 以 Bearer 帶 ADMIN_API_TOKEN（字面相符）→ super_admin。
#      - 或 Firebase 使用者 users.role ∈ ('admin','super_admin') → super_admin。
#   2) caregiver（只能看被授權的住民，resident_caregiver_links）
#      - 以 Bearer 帶 Firebase ID Token → 後端 verifyIdToken → users.role='caregiver'。
#
# ADMIN_API_TOKEN = **super_admin token**（最高權限共享權杖）。
# - production 必填（缺則 fail-fast）。請用隨機字串，只放本機 .env、勿進版控。
# - 切勿發給一般照護人員；一般照護人員應走 Firebase 登入（CR-0042 caregiver_web）。
# - super_admin-only 路由（/api/admin/users、/api/admin/overview、marketplace admin）
#   只接受此 token（requireAdmin）。
# - caregiver 身分驗證需上面 Firebase 服務帳戶變數（FIREBASE_* / GOOGLE_APPLICATION_CREDENTIALS），
#   不需任何新增 secret（路線 A，無 JWT_SECRET / SESSION_SECRET）。
# 正式產品的 caregiver 帳號 provisioning（建 users.role='caregiver' + resident_caregiver_links）
# 屬後續 CR（super_admin-only 端點）。
ADMIN_API_TOKEN=


# -----------------------------------------------------------------------------
# Privacy / Store Links（隱私 / 上架連結）
# -----------------------------------------------------------------------------
# 注意：隱私權政策 / 服務條款 / 支援頁 / 客服信箱目前由「Flutter 端」LegalConfig
#       常數管理（lib/config/legal_config.dart 的 privacyPolicyUrl /
#       termsOfServiceUrl / supportUrl / contactEmail，現為 TODO 佔位）。
#       後端 config/env.js 目前不讀取這些變數，故此處不放後端 env，避免捏造不存在
#       的變數。若日後後端需要對外公開這些連結，再於此新增對應名稱。


# -----------------------------------------------------------------------------
# Development-only Flags（開發 / 治理旗標；production 強制安全值）
# -----------------------------------------------------------------------------
# 安全 boolean 解析：只有 'true' / '1' 視為真，其餘一律 false（config/env.js parseBoolean）。
#
# ALLOW_MOCK_SERVICES: 是否允許 mock 服務 / mock auth。
#   dev=true、staging/production=false。production 顯式 true → fail-fast。
ALLOW_MOCK_SERVICES=false
# ALLOW_JSON_FALLBACK: 是否允許 JSON store 作為 fallback / 唯一資料來源。
#   dev=true、staging 可設、production 強制 false。production 顯式 true → fail-fast。
#   （care alert 在 production 改 DB-required，見 PROJECT_ARCHITECTURE.md §5.3.1。）
ALLOW_JSON_FALLBACK=true
# REQUIRE_AUTH: production 強制驗 token（收斂 AUTH_ALLOW_MOCK）。
#   dev=false、staging/production=true。production 顯式 false → fail-fast。
REQUIRE_AUTH=false
# REQUIRE_CONSENT: 對映 consent gate（治理表 §7.1；後端尚未全面接入，先列名稱）。
#   dev=false、staging/production=true。
REQUIRE_CONSENT=false
# ENABLE_VERBOSE_LOGS: 詳細 log（治理表 §7.1；用於收斂散落 console.*）。
#   dev=true、staging/production=false。production log 不得輸出 secret / 完整個資。
ENABLE_VERBOSE_LOGS=true
# SHOW_DEV_PANELS: 注意這是「Flutter 端」的 --dart-define 旗標（非後端 env），
#   列於此僅為集中對照。production 強制 false（見 lib/config/app_config.dart）。


# -----------------------------------------------------------------------------
# 其它可選（資料檔路徑覆寫 / 外部工具；一般不需設定）
# -----------------------------------------------------------------------------
# REDIS_URL=                       # 集中式 rate limiter（本機開發不需要）
# FFMPEG_PATH=                     # 自訂 ffmpeg 路徑
# 各 *_DATA_FILE / *_DATA_DIR：JSON store 路徑覆寫（dev/test 用，production 走 DB）。
