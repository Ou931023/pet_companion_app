OPENAI_API_KEY=
TAVILY_API_KEY=
PORT=3001
# HOST: 後端綁定的網路介面。
# - 純本機 / 模擬器開發：可用 127.0.0.1
# - iPhone 實機 Demo：請設為 0.0.0.0，後端才會綁定所有網路介面，
#   讓同一個 Wi-Fi 下的 iPhone 連得到後端。
HOST=0.0.0.0
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=alloy
DATABASE_URL=postgres://postgres:password@localhost:5432/love_companion
EMBEDDING_MODEL=text-embedding-3-small
MEMORY_TOP_K=5
# Optional: restrict allowed CORS origins for browser clients (comma-separated)
# Example: ALLOWED_ORIGINS=http://localhost:5500,http://192.168.0.17:5500
ALLOWED_ORIGINS=

# Rate limit settings (per express-rate-limit)
# REALTIME_RATE_LIMIT_WINDOW_MS: window in ms for realtime endpoints (default 60000)
# REALTIME_RATE_LIMIT_MAX: max requests per window for realtime endpoints (default 6)
REALTIME_RATE_LIMIT_WINDOW_MS=60000
REALTIME_RATE_LIMIT_MAX=6

# Global rate limit defaults
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_CALLS=60

# Optional Redis URL for centralized rate limiter (not required for local dev)
# REDIS_URL=redis://localhost:6379

# Telegram 長照通知（Care Alert → Telegram）
# - TELEGRAM_BOT_TOKEN：向 @BotFather 申請的 Bot token。
# - TELEGRAM_CARE_CHAT_ID：接收通知的長照人員 / 家屬 chat id。
# 兩者只放在本機 .env，請勿填入此範例檔、勿進版控。任一為空時通知會回傳
# telegram_not_configured，不影響語音與本機 CareAlert。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CARE_CHAT_ID=
